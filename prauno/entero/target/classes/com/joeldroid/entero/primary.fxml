<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="2.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.joeldroid.entero.PrimaryController">
   <children>
      <Label text="Ingrese un número"/>
      <TextField fx:id="txtnum" text=""/>
      <Button fx:id="btnana" text="Analizar" onAction="#analizar"/>
      <Button fx:id="btnlim" text="Limpiar" onAction="#limpiar"/>
      <Label text="Cantidad de cifras"/>
      <TextField fx:id="txtcan" text=""/>
      <Label text="Suma de cifras impares"/>
      <TextField fx:id="txtim" text=""/>
      <Label text="Suma de cifras pares"/>
      <TextField fx:id="txtpar" text=""/>
      <Label text="Suma total de cifras"/>
      <TextField fx:id="txttol" text=""/>
      <Label text="Cifra mayor"/>
      <TextField fx:id="txtmay" text=""/>
      <Label text="Cifra menor"/>
      <TextField fx:id="txtmen" text=""/>
      <Label text="Divisores"/>
      <ListView fx:id="listd"/> 
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
